# =========================
# 系统文件
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# 编辑器 / IDE
# =========================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 如果想保留 VS Code 配置，可以改成这样：
# .vscode/*
# !.vscode/settings.json
# !.vscode/extensions.json

# =========================
# 日志文件
# =========================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# 环境变量 / 密钥文件
# =========================
.env
.env.*
!.env.example

# =========================
# Node.js / 前端项目
# =========================
node_modules/
dist/
build/
.cache/
.parcel-cache/
.next/
.nuxt/
out/
coverage/

# =========================
# Python 项目
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/

# =========================
# Java 项目
# =========================
target/
*.class
*.jar
*.war
*.ear

# =========================
# C / C++ 编译文件
# =========================
*.o
*.obj
*.exe
*.dll
*.so
*.out
*.a
*.lib

# =========================
# 压缩包
# =========================
*.zip
*.rar
*.7z
*.tar
*.gz

# =========================
# 临时文件
# =========================
tmp/
temp/
*.tmp
*.bak
*.old

# =========================
# 数据文件，可按需取消注释
# =========================
# *.csv
# *.xlsx
# *.xls
# *.db
# *.sqlite

# =========================
# 图片 / 视频资源一般不要忽略
# 如果项目里 assets 需要上传，不要写 assets/
# =========================